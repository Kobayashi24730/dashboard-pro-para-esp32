datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String   @id @default(uuid())
  nome      String?
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}

model sensor_data {
  id         String   @id @default(cuid())

  device_id  String
  sensor     String

  estado     Boolean
  valor      Float?

  createdAt  DateTime @default(now())

  @@index([sensor])
  @@index([device_id])
  @@map("sensor_data")
}